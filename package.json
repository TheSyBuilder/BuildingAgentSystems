{
  "name": "building-agent-systems",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node --experimental-strip-types scripts/prepare-sites-build.ts",
    "capture:demo": "pnpm build && node --experimental-strip-types scripts/capture-agent-loop-demo.ts",
    "agent:triage": "node --experimental-strip-types scripts/run-read-only-triage.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:fixtures": "node --experimental-strip-types scripts/verify-issue-snapshot.ts",
    "test:agent": "node --experimental-strip-types scripts/verify-read-only-triage.ts",
    "test:hosting": "node --experimental-strip-types scripts/verify-sites-build.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:links": "linkinator dist --recurse"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "motion": "12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "lighthouse": "13.4.1",
    "linkinator": "8.0.2",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.9.0"
}
